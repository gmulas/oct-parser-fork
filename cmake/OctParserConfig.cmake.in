# CMake package configuration for oct_parser (standalone liboct_parser).
# Generated by the oct_parser autotools build.
#
# Usage:
#   find_package(OctParser REQUIRED)                      # C / C++
#   find_package(OctParser REQUIRED COMPONENTS Fortran)   # also the Fortran module
#   target_link_libraries(myprog PRIVATE OctParser::oct_parser)     # C / C++
#   target_link_libraries(myprog PRIVATE OctParser::oct_parser_f)   # Fortran
#
# If the installation prefix is not a standard one, point CMake to it with
#   -DCMAKE_PREFIX_PATH=<prefix>   (or -DOctParser_DIR=<prefix>/lib/cmake/OctParser)
#
# Set OctParser_USE_STATIC=ON before find_package() to prefer the static
# libraries (liboct_parser.a) over the shared ones.
#
# Also defined, for old-style use: OctParser_INCLUDE_DIRS, OctParser_LIBRARIES,
# OctParser_Fortran_MODULE_DIR, OctParser_VERSION.

cmake_minimum_required(VERSION 3.12)

set(OctParser_VERSION "@PACKAGE_VERSION@")
set(OctParser_OCTOPUS_COMMIT "@OCTOPUS_COMMIT@")
set(OctParser_INCLUDE_DIR "@includedir@")
set(OctParser_LIBRARY_DIR "@libdir@")
set(OctParser_Fortran_MODULE_DIR "@fmoddir@")
set(OctParser_Fortran_FOUND @HAVE_FORTRAN@)

if(NOT TARGET OctParser::oct_parser)

  # --- the library files ---------------------------------------------
  if(OctParser_USE_STATIC)
    set(_octp_names liboct_parser.a oct_parser)
    set(_octp_f_names liboct_parser_f.a oct_parser_f)
  else()
    set(_octp_names oct_parser)
    set(_octp_f_names oct_parser_f)
  endif()
  find_library(OctParser_LIBRARY NAMES ${_octp_names}
               PATHS "${OctParser_LIBRARY_DIR}" NO_DEFAULT_PATH)
  if(NOT OctParser_LIBRARY)
    set(OctParser_FOUND FALSE)
    set(OctParser_NOT_FOUND_MESSAGE "liboct_parser not found in ${OctParser_LIBRARY_DIR}")
    return()
  endif()

  # --- GSL (the only dependency) ---------------------------------------
  # Use CMake's FindGSL, pointed at the GSL found when oct_parser was
  # configured; fall back to the compiler flags recorded at that time.
  set(_octp_gsl_prefix "@GSL_PREFIX@")
  if(_octp_gsl_prefix AND NOT GSL_ROOT_DIR)
    set(GSL_ROOT_DIR "${_octp_gsl_prefix}")
  endif()
  find_package(GSL QUIET)
  if(TARGET GSL::gsl)
    set(_octp_gsl_link GSL::gsl)
    set(_octp_gsl_inc "")
  else()
    separate_arguments(_octp_cflags UNIX_COMMAND "@GSL_CFLAGS@")
    separate_arguments(_octp_gsl_link UNIX_COMMAND "@GSL_LIBS@")
    set(_octp_gsl_inc "")
    foreach(_f IN LISTS _octp_cflags)
      if(_f MATCHES "^-I(.+)")
        list(APPEND _octp_gsl_inc "${CMAKE_MATCH_1}")
      endif()
    endforeach()
  endif()
  separate_arguments(_octp_extra_libs UNIX_COMMAND "@LIBS@")

  add_library(OctParser::oct_parser UNKNOWN IMPORTED)
  set_target_properties(OctParser::oct_parser PROPERTIES
    IMPORTED_LOCATION "${OctParser_LIBRARY}"
    IMPORTED_LINK_INTERFACE_LANGUAGES "C"
    INTERFACE_INCLUDE_DIRECTORIES "${OctParser_INCLUDE_DIR};${_octp_gsl_inc}"
    INTERFACE_LINK_LIBRARIES "${_octp_gsl_link};${_octp_extra_libs}")

  if(OctParser_Fortran_FOUND)
    find_library(OctParser_Fortran_LIBRARY NAMES ${_octp_f_names}
                 PATHS "${OctParser_LIBRARY_DIR}" NO_DEFAULT_PATH)
    if(OctParser_Fortran_LIBRARY)
      add_library(OctParser::oct_parser_f UNKNOWN IMPORTED)
      set_target_properties(OctParser::oct_parser_f PROPERTIES
        IMPORTED_LOCATION "${OctParser_Fortran_LIBRARY}"
        IMPORTED_LINK_INTERFACE_LANGUAGES "Fortran"
        INTERFACE_INCLUDE_DIRECTORIES "${OctParser_Fortran_MODULE_DIR}"
        INTERFACE_LINK_LIBRARIES OctParser::oct_parser)
    else()
      set(OctParser_Fortran_FOUND FALSE)
    endif()
  endif()

  unset(_octp_names)
  unset(_octp_f_names)
  unset(_octp_cflags)
  unset(_octp_gsl_prefix)
endif()

set(OctParser_INCLUDE_DIRS "${OctParser_INCLUDE_DIR};${_octp_gsl_inc}")
set(OctParser_LIBRARIES OctParser::oct_parser)

# --- components ----------------------------------------------------------
foreach(_comp IN LISTS OctParser_FIND_COMPONENTS)
  if(NOT _comp STREQUAL "Fortran")
    set(OctParser_${_comp}_FOUND FALSE)
  endif()
  if(OctParser_FIND_REQUIRED_${_comp} AND NOT OctParser_${_comp}_FOUND)
    set(OctParser_FOUND FALSE)
    set(OctParser_NOT_FOUND_MESSAGE
        "component ${_comp} not available (rebuild oct_parser with --enable-fortran for the Fortran module)")
  endif()
endforeach()
